# Server Settings
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# Google Sheets Integration
# Extract the spreadsheet ID from Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Path to your Google Service Account credentials JSON file (for local dev)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# OR Raw JSON credentials string (Ideal for Vercel / Cloud deployment environment variables)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional: Google Gemini API Key for advanced AI reasoning & replays
# If left empty, the built-in intelligent Khmer & English reply engine is used
GEMINI_API_KEY=
